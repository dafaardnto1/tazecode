/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://tazecode-api.dafaardianto466.workers.dev; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# HTML shell — never cache. Browsers/CDN must always fetch the latest so a
# new deploy is visible immediately instead of showing a stale cached page.
/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

# Hashed build assets (filename changes on every content change) — safe to
# cache aggressively and forever, since a new deploy always gets a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
